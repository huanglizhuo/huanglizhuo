      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"/posts/\">Posts</a><a href=\"/projects/\" aria-current=\"page\">Projects</a><a href=\"/zh/\" lang=\"zh\">ZH</a></nav>",
      "css": ".ds-nav{display:flex;gap:1.25rem;font-size:.875rem;font-family:var(--font-app,\"Segoe UI\",sans-serif);}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:.25rem .5rem;color:var(--foreground,#182443);font-weight:500;text-decoration:none}.ds-nav a[aria-current]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:8px}.ds-nav a:hover{color:var(--accent,#294acb)}.ds-nav a:focus-visible{outline:2px dashed var(--accent,#294acb);outline-offset:1px;text-decoration:none}"
    },
    {
      "name": "Project caption",
      "kind": "card",
      "refersTo": "project-caption",
      "description": "Open caption below the image field.",
      "html": "<article class=\"ds-caption\"><h3><a href=\"/projects/echopod/\">EchoPod<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 18l6-6-6-6\"/></svg></a></h3><p>A place for language learning.</p></article>",
      "css": ".ds-caption{color:var(--foreground,#182443);font-family:var(--font-app,\"Segoe UI\",sans-serif);}.ds-caption h3{margin:0;font-family:var(--font-display,\"Bricolage Grotesque\"),\"PingFang SC\",sans-serif;font-size:1.75rem;line-height:1.2;font-weight:600;letter-spacing:-.025em}.ds-caption a{display:flex;align-items:center;justify-content:space-between;gap:1rem;color:inherit;text-decoration:none}.ds-caption svg{color:var(--accent,#294acb);flex-shrink:0}.ds-caption a:hover{color:var(--accent,#294acb)}.ds-caption a:focus-visible{outline:2px dashed var(--accent,#294acb);outline-offset:1px;text-decoration:none}.ds-caption p{margin:.75rem 0 0;max-width:60ch;line-height:1.7}"
