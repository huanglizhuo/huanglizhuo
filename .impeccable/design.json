      "kind": "button",
      "refersTo": "collection-link",
      "description": "Underlined project navigation action.",
      "html": "<a class=\"ds-collection\" href=\"#projects\">Explore my projects<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 18l6-6-6-6\"/></svg></a>",
      "css": ".ds-collection{display:inline-flex;align-items:center;gap:.75rem;min-height:44px;color:var(--accent,#294acb);font-weight:600;text-decoration:underline;text-underline-offset:6px;font-family:var(--font-app,\"Segoe UI\",sans-serif);}.ds-collection:focus-visible{outline:2px dashed var(--accent,#294acb);outline-offset:1px;text-decoration:none}"
    },
    {
      "name": "Link button",
      "kind": "button",
      "refersTo": "link-button",
      "description": "Shared text-and-icon navigation link.",
      "html": "<a class=\"ds-link\" href=\"/posts/\">All posts<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 18l6-6-6-6\"/></svg></a>",
      "css": ".ds-link{display:inline-flex;align-items:center;gap:.25rem;color:var(--foreground,#182443);font-family:var(--font-app,\"Segoe UI\",sans-serif);}.ds-link:hover{color:var(--accent,#294acb)}.ds-link:focus-visible{outline:2px dashed var(--accent,#294acb);outline-offset:1px;text-decoration:none}"
    },
