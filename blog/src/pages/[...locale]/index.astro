---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostLocale, getContentLocale } from "@/utils/getPostPaths";
import { getLocaleStaticPaths, useTranslations } from "@/i18n";
import config from "@/config";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const isZh = locale === "zh";

const projects = (await getCollection("projects"))
  .filter(
    project =>
      getContentLocale(project.filePath, "src/content/projects") === locale
  )
  .sort((a, b) => a.data.order - b.data.order);

const posts = await getCollection("posts");
const localePosts = posts.filter(
  post => getPostLocale(post.filePath) === locale
);
const sortedPosts = getSortedPosts(localePosts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout wide>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="my-1"
  >
    <section id="hero" class="app-layout home-intro">
      <div>
        <h1>
          {isZh ? "你好，" : "Hi, I'm"}<br /><span
            >Huang<span class="intro-period">.</span></span
          >
        </h1>
      </div>
      <div class="intro-copy">
        <p>
          {
            isZh
              ? "我写 Mobile，写 Web，也胡乱写，主要为了好玩。在这里分享正在做的项目，也记录一路学到的东西。"
              : "I build things for the mobile, for the web, for language learners, and for fun. Here are the projects I work on, and notes on what I learn along the way."
          }
        </p>
        <div class="intro-links">
          <a href="#projects" class="collection-link">
            {isZh ? "看看我的项目" : "Explore my projects"}
            <IconArrowRight width={20} height={20} aria-hidden="true" />
          </a>
          {socials.length > 0 && <Socials />}
        </div>
      </div>
    </section>

    <section id="projects" class="app-layout collection-section">
      <div class="section-heading">
        <h2>{isZh ? "把想法，做出来。" : "Ideas, made real."}</h2>
        <span
          >{
            isZh
              ? `${projects.length} 个项目，持续探索`
              : `${projects.length} projects. Always exploring.`
          }</span
        >
      </div>
      <div class="project-grid">
        {
          projects.map((project, i) => (
            <ProjectCard
              {project}
              wide={i === 0 && projects.length % 2 === 1}
            />
          ))
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "app-layout pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="app-layout pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="app-layout writing-links">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <a href={getRelativeLocaleUrl(locale, "rss.xml")} class="rss-link">
        <IconRss width={18} height={18} aria-hidden="true" />
        {isZh ? "订阅 RSS" : "Subscribe via RSS"}
      </a>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style>
  .home-intro {
    display: grid;
    gap: 2rem;
    padding-block: 3.5rem 4rem;
  }
  h1 {
    font-size: clamp(3.5rem, 6.7vw, 5.5rem);
    font-weight: 600;
    line-height: 0.98;
    color: var(--accent);
  }
  .intro-period {
    color: var(--foreground);
  }
  .intro-copy {
    max-width: 29rem;
    align-self: end;
  }
  .intro-copy > p {
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .intro-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .collection-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .section-heading h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
  }
  .section-heading > span {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .project-grid {
    display: grid;
    gap: 3.5rem 2rem;
  }
  .collection-section {
    padding-bottom: 4rem;
  }
  .writing-links {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-block: 1rem 4rem;
  }
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
  .rss-link:hover {
    color: var(--accent);
  }
  @media (min-width: 640px) {
    .home-intro {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 3rem;
      padding-block: 4.5rem;
    }
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
