---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostLocale, getContentLocale } from "@/utils/getPostPaths";
import { getLocaleStaticPaths, useTranslations } from "@/i18n";
import config from "@/config";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const isZh = locale === "zh";

// What the projects turn into what, shown under the intro.
const signals = isZh
  ? [
      ["播客", "字幕"],
      ["语音", "文本"],
      ["手印", "文字"],
      ["仓库", "行数"],
      ["状态", "面板"],
    ]
  : [
      ["podcasts", "subtitles"],
      ["speech", "text"],
      ["hand signs", "text"],
      ["repos", "line counts"],
      ["system status", "one panel"],
    ];

const projects = (await getCollection("projects"))
  .filter(
    project =>
      getContentLocale(project.filePath, "src/content/projects") === locale
  )
  .sort((a, b) => a.data.order - b.data.order);

const posts = await getCollection("posts");
const localePosts = posts.filter(post => getPostLocale(post.filePath) === locale);
const sortedPosts = getSortedPosts(localePosts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout wide>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="my-1"
  >
    <section id="hero" class="relative overflow-hidden">
      <div class="hero-art" data-shader="hero" aria-hidden="true">
        <canvas style="width: 100%; height: 100%"></canvas>
      </div>
      <div
        class="app-layout pointer-events-none relative pt-6 pb-12 sm:py-16 [&>*]:pointer-events-auto"
      >
        <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
          {isZh ? "你好，我是 Huang" : "Hi, I'm Huang"}
        </h1>
        <a
          target="_blank"
          href={getRelativeLocaleUrl(locale, "rss.xml")}
          class="inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>

        <p class="max-w-lg font-sans">
          {
            isZh
              ? "我写 Mobile, Web, 胡乱写，主要为了好玩。下面是我正在做的项目，也会在这里记录些奇奇怪怪的内容"
              : "I build things for the mobile, for the web, for language learners, and for fun. Below are the projects I work on — I also write notes about what I learn along the way."
          }
        </p>
        <p
          class="text-muted-foreground mt-4 flex max-w-lg flex-wrap gap-x-4 gap-y-1 text-sm"
        >
          {
            signals.map(([from, to]) => (
              <span class="whitespace-nowrap">
                {from} <span class="text-accent">→</span> {to}
              </span>
            ))
          }
        </p>
        {
          socials.length > 0 && (
            <div class="mt-4 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    <section
      id="projects"
      class="app-layout border-border border-b pt-12 pb-10"
    >
      <h2 class="text-2xl font-semibold tracking-wide">
        {t.pages.projectsTitle}
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {
          projects.map((project, i) => (
            <ProjectCard
              {project}
              wide={i === 0 && projects.length % 2 === 1}
            />
          ))
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "app-layout pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="app-layout pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="app-layout my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
