---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostLocale, getContentLocale } from "@/utils/getPostPaths";
import { getLocaleStaticPaths, useTranslations } from "@/i18n";
import config from "@/config";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import octocountsImg from "@/assets/projects/octocounts.png";
import echopodImg from "@/assets/projects/echopod.png";
import fusebarImg from "@/assets/projects/fusebar.png";
import ketsuinImg from "@/assets/projects/ketsuin.png";
import qwenasrImg from "@/assets/projects/qwenasr.png";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const projectImages: Record<string, ImageMetadata> = {
  octocounts: octocountsImg,
  echopod: echopodImg,
  fusebar: fusebarImg,
  ketsuin: ketsuinImg,
  qwenasr: qwenasrImg,
};

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const isZh = locale === "zh";

const projects = (await getCollection("projects"))
  .filter(
    project =>
      getContentLocale(project.filePath, "src/content/projects") === locale
  )
  .sort((a, b) => a.data.order - b.data.order);

const posts = await getCollection("posts");
const localePosts = posts.filter(post => getPostLocale(post.filePath) === locale);
const sortedPosts = getSortedPosts(localePosts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        {isZh ? "你好，我是 Huang" : "Hi, I'm Huang"}
      </h1>
      <a
        target="_blank"
        href={getRelativeLocaleUrl(locale, "rss.xml")}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        {
          isZh
          ? "我写 Mobile, Web, 胡乱写，主要为了好玩。下面是我正在做的项目，也会在这里记录些奇奇怪怪的内容"
            : "I build things for the mobile, for the web, for language learners, and for fun. Below are the projects I work on — I also write notes about what I learn along the way."
        }
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <section id="projects" class="border-border border-b pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">
        {t.pages.projectsTitle}
      </h2>
      {
        projects.map(({ id, data }) => {
          const slug = id.split("/").pop() ?? id;
          const image = projectImages[slug];
          const projectUrl = getRelativeLocaleUrl(
            locale,
            `projects/${slug}`
          );
          return (
            <div class="mt-8">
              {image && (
                <a href={projectUrl}>
                  <Image
                    src={image}
                    alt={`${data.title} preview`}
                    widths={[768, 1536]}
                    sizes="(max-width: 768px) 100vw, 768px"
                    class="border-border rounded-lg border"
                  />
                </a>
              )}
              <h3 class="mt-4 text-xl font-semibold">
                <a href={projectUrl} class="hover:text-accent">
                  {data.title}
                </a>
              </h3>
              <a
                href={data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-sm opacity-70 hover:opacity-100"
              >
                {data.domain}
              </a>
              <p class="mt-2">{data.tagline}</p>
              <table class="mt-3 w-full border-collapse text-sm">
                <tbody>
                  {data.facts.map(fact => (
                    <tr class="border-border border-b">
                      <th class="text-muted-foreground py-1.5 pe-4 text-left align-top font-medium whitespace-nowrap">
                        {fact.label}
                      </th>
                      <td class="py-1.5">{fact.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mt-3">
                <LinkButton href={projectUrl}>
                  {isZh ? "查看详情" : "Read more"}
                  <IconArrowRight class="inline-block rtl:-rotate-180" />
                </LinkButton>
              </p>
            </div>
          );
        })
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
