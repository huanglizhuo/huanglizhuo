---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getContentLocale } from "@/utils/getPostPaths";
import { getLocaleStaticPaths, useTranslations } from "@/i18n";
import config from "@/config";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = (await getCollection("projects"))
  .filter(project => getContentLocale(project.filePath, "src/content/projects") === locale)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title={`${t.pages.projectsTitle} | ${config.site.title}`} wide>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.projectsTitle} pageDesc={t.pages.projectsDesc}>
    <div class="grid gap-5 pb-6 sm:grid-cols-2">
      {
        projects.map((project, i) => (
          <ProjectCard
            {project}
            variant="h2"
            wide={i === 0 && projects.length % 2 === 1}
          />
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
