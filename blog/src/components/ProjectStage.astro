---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import octocountsImg from "@/assets/projects/octocounts.png";
import echopodImg from "@/assets/projects/echopod.png";
import fusebarImg from "@/assets/projects/fusebar.png";
import ketsuinImg from "@/assets/projects/ketsuin.png";
import qwenasrImg from "@/assets/projects/qwenasr.png";

type Props = {
  slug: string;
  title: string;
  // "wide" spans the home grid; "banner" tops the project page.
  variant?: "card" | "wide" | "banner";
};

const projectImages: Record<string, ImageMetadata> = {
  octocounts: octocountsImg,
  echopod: echopodImg,
  fusebar: fusebarImg,
  ketsuin: ketsuinImg,
  qwenasr: qwenasrImg,
};

// The project's shader (src/scripts/shaders.ts) plays behind its screenshot.
const { slug, title, variant = "card" } = Astro.props;
const image = projectImages[slug];
---

<div
  data-shader={slug}
  transition:name={`project-${slug}`}
  class:list={[
    "relative isolate overflow-hidden",
    variant === "wide" ? "aspect-16/10 sm:aspect-21/9" : "aspect-16/10",
    { "rounded-lg": variant === "banner" },
  ]}
>
  <canvas aria-hidden="true" style="width: 100%; height: 100%"></canvas>
  {
    image && (
      <Image
        src={image}
        alt={`${title} preview`}
        widths={[480, 800, 1280]}
        sizes={
          variant === "card"
            ? "(min-width: 640px) 380px, 76vw"
            : "(min-width: 640px) 600px, 76vw"
        }
        loading={variant === "banner" ? "eager" : "lazy"}
        class:list={[
          "absolute right-[4%] -bottom-[10%] z-10 w-[76%] rounded-lg shadow-2xl ring-1 ring-white/10",
          "transition-transform duration-500 group-hover:-translate-y-2 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0",
          { "sm:-bottom-[16%] sm:w-[60%]": variant === "wide" },
        ]}
      />
    )
  }
</div>
