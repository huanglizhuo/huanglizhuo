---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import octocountsImg from "@/assets/projects/octocounts.png";
import echopodImg from "@/assets/projects/echopod.png";
import fusebarImg from "@/assets/projects/fusebar.png";
import ketsuinImg from "@/assets/projects/ketsuin.png";
import qwenasrImg from "@/assets/projects/qwenasr.png";

type Props = {
  slug: string;
  title: string;
  // "wide" spans the home grid; "banner" tops the project page.
  variant?: "card" | "wide" | "banner";
};

const projectImages: Record<string, ImageMetadata> = {
  octocounts: octocountsImg,
  echopod: echopodImg,
  fusebar: fusebarImg,
  ketsuin: ketsuinImg,
  qwenasr: qwenasrImg,
};

const { slug, title, variant = "card" } = Astro.props;
const image = projectImages[slug];
---

<div
  data-project={slug}
  transition:name={`project-${slug}`}
  class:list={["project-stage", { "project-banner": variant === "banner" }]}
>
  {
    image && (
      <Image
        src={image}
        alt={`${title} preview`}
        widths={[480, 800, 1280]}
        sizes={
          variant === "banner"
            ? "(min-width: 768px) 700px, 90vw"
            : "(min-width: 1200px) 580px, (min-width: 640px) 45vw, 90vw"
        }
        loading={variant === "card" ? "lazy" : "eager"}
        class="project-image"
      />
    )
  }
</div>

<style>
  .project-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2rem;
    aspect-ratio: 4 / 3;
    background: #c8d8eb;
  }
  .project-image {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 12px 24px rgb(15 30 60 / 0.16);
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.project-card:hover) .project-image,
  :global(.project-card:focus-within) .project-image {
    transform: translateY(-5px);
  }
  [data-project="echopod"] {
    background: #b7d8cf;
  }
  [data-project="octocounts"] {
    background: #c6cee9;
  }
  [data-project="fusebar"] {
    background: #b6cbed;
  }
  [data-project="ketsuin"] {
    background: #e4cfb8;
  }
  [data-project="qwenasr"] {
    background: #d6c6df;
  }
  :global([data-theme="dark"]) .project-stage {
    background: #273953;
  }
  :global([data-theme="dark"]) [data-project="echopod"] {
    background: #234941;
  }
  :global([data-theme="dark"]) [data-project="octocounts"] {
    background: #303957;
  }
  :global([data-theme="dark"]) [data-project="ketsuin"] {
    background: #4b3c2f;
  }
  :global([data-theme="dark"]) [data-project="qwenasr"] {
    background: #44364e;
  }
  .project-banner {
    aspect-ratio: 16 / 10;
    padding: 2.5rem;
  }
  @media (max-width: 639px) {
    .project-stage {
      padding: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-image {
      transition: none;
      transform: none !important;
    }
  }
</style>
